{
  "name": "Bus assistant webhook",
  "nodes": [
    {
      "id": "b1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "bus-assistant",
      "parameters": {
        "httpMethod": "POST",
        "path": "bus-assistant",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "b2",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "appUrl",
              "type": "string",
              "value": "http://localhost:5000"
            },
            {
              "id": "c2",
              "name": "message",
              "type": "string",
              "value": "={{ $('Webhook').first().json.body.message }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b3",
      "name": "Ask assistant",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $json.appUrl }}/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $json.message }) }}",
        "options": {}
      }
    },
    {
      "id": "b4",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ reply: $json.response ?? 'The assistant is unavailable right now.' }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Ask assistant",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask assistant": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
