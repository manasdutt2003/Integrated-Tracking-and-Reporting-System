# Signs session cookies. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Demo account passwords (defaults: pass123 / adminpass)
DEMO_USER_PASSWORD=
ADMIN_PASSWORD=

# AI assistant (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Email notifications (Gmail address and an app password)
EMAIL_USER=
EMAIL_PASS=
# Optional link appended to notification emails
LIVE_TRACKING_URL=
